{
  "name": "watchtower",
  "version": "0.0.0",
  "description": "Visualization layer for sandcastle: a multi-run dashboard for parallel sandboxed AI coding agents.",
  "homepage": "https://github.com/jnsdls/watchtower",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jnsdls/watchtower.git"
  },
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "bun run typecheck && bun run lint && bun test",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "sandcastle": "bun .sandcastle/main.ts"
  },
  "packageManager": "bun@1.3.12",
  "engines": {
    "node": ">=22",
    "bun": ">=1.2"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.5.6",
    "@biomejs/biome": "^2.3.8",
    "@types/bun": "^1.3.0",
    "@types/node": "^25.6.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  },
  "patchedDependencies": {
    "@ai-hero/sandcastle@0.5.7": "patches/@ai-hero%2Fsandcastle@0.5.7.patch"
  }
}
